        },
        {
          "name": "Test workspace AI credential (counts against quota)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workspaceToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/workspace/ai/settings/test",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"{{workspaceAIProvider}}\",\n  \"model\": \"{{workspaceAIModel}}\",\n  \"apiKey\": \"{{workspaceAIKey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Workspace AI usage",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workspaceToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/workspace/ai/usage"
          }
        },
        {
          "name": "Ask workspace copilot (provider request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workspaceToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/workspace/ai/ask",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Summarize the most urgent inventory risks using only the current workspace records. Explain what data I should verify before requesting a purchase.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List API keys (owner/admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workspaceToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/workspace/api-keys"
          }
        },
        {
          "name": "Create read-only API key (copy token once)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workspaceToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/workspace/api-keys",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman reporting\",\n  \"scopes\": [\n    \"inventory:read\",\n    \"suppliers:read\",\n    \"purchasing:read\"\n  ],\n  \"expiresInDays\": 90\n}",
              "options": {
