            "url": "{{baseUrl}}/api/workspace/purchase-requests/{{purchaseRequestId}}/transition",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ordered\",\n  \"orderedQuantity\": 5,\n  \"note\": \"Sample order transition; use an approved test request\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Workspace AI settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workspaceToken}}"
              }
