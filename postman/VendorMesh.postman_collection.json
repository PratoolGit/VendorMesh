        {
          "name": "Record invoice for review (manual entry)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workspaceToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/workspace/invoices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purchaseRequestId\": \"{{purchaseRequestId}}\",\n  \"invoiceNumber\": \"{{invoiceNumber}}\",\n  \"invoiceDate\": \"2026-10-29\",\n  \"dueDate\": \"2026-11-28\",\n  \"currency\": \"USD\",\n  \"subtotal\": 50,\n  \"taxTotal\": 0,\n  \"total\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
