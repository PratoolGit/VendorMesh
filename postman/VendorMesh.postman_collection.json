              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/workspace/suppliers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Supplier {{$timestamp}}\",\n  \"email\": \"qa-supplier@example.com\",\n  \"leadTimeDays\": 5,\n  \"reliabilityScore\": 90,\n  \"paymentTerms\": \"Net 30\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
