            "url": "{{baseUrl}}/api/v1/inventory?limit=50&lowStock=true"
          }
        },
        {
          "name": "Suppliers (active only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workspaceAPIKey}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/suppliers?limit=50&active=true"
          }
        },
        {
          "name": "Purchase requests (pending)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workspaceAPIKey}}"
              }
