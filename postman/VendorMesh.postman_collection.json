    {
      "name": "Public API v1 (read-only API key)",
      "description": "Set workspaceAPIKey in a PRIVATE Postman environment. The workspace session Bearer token is not accepted here. Only read scopes exist; these endpoints cannot modify data or approve purchases.",
      "item": [
        {
          "name": "Inventory (optional low-stock filter)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{workspaceAPIKey}}"
              }
