                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/workspace/pricing-simulator",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"basePrice\": 100,\n  \"unitCost\": 60,\n  \"baselineUnits\": 100,\n  \"elasticity\": 1.2\n}",
