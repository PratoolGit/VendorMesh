# Copy to .env for local development. Replace placeholders locally; never commit real secrets.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vendormesh
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

# Use separate random secrets. Production AUTH_TOKEN_SECRET must be at least 32 characters.
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_API_TOKEN=replace-with-a-random-token-at-least-24-characters
AI_SETTINGS_ENCRYPTION_KEY=replace-with-a-random-key-at-least-24-characters

# Optional AI fallback; saved provider credentials are encrypted in MongoDB.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# PayPal Sandbox only for local development; leave blank when not testing PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_VENDOR_PAYEE_EMAIL=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

INITIAL_BANK_BALANCE=25000
MIN_CASH_RESERVE=5000
MAX_SINGLE_PAYMENT=15000
ENABLE_CRON=false
AGENT_CRON_SCHEDULE=*/10 * * * *
